{
  "manifest_version": 3,
  "name": "Min network helper",
  "version": "1.0",
  "description": "Built into Min, and only loaded while an extension filters normal tabs' network requests: keeps Google sign-in and tracking-parameter removal working with rules Min sets (main/extensions.js).",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
