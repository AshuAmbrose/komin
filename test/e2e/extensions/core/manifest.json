{
  "manifest_version": 3,
  "name": "Min test: core",
  "version": "1.0",
  "description": "Test extension for Min's extension core: lifecycle events, tabs, a content script.",
  "background": { "service_worker": "sw.js" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end" }
  ],
  "icons": { "48": "icon.png" }
}
