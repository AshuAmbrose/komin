{
  "manifest_version": 3,
  "name": "Min test: toolbar",
  "version": "1.0",
  "description": "Test extension for Min's toolbar buttons, popups, menus, options page and keyboard shortcuts.",
  "background": { "service_worker": "sw.js" },
  "permissions": ["storage", "tabs", "contextMenus"],
  "action": { "default_popup": "popup.html", "default_title": "Min toolbar test", "default_icon": { "16": "icon.png", "48": "icon.png" } },
  "options_page": "options.html",
  "icons": { "48": "icon.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Open the popup" },
    "say-hello": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Say hello" },
    "clash": { "suggested_key": { "default": "Ctrl+T" }, "description": "Clashes with Min's new tab shortcut" }
  }
}
